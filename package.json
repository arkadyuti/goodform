{
  "name": "goodform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.34.4",
  "scripts": {
    "dev": "pnpm --parallel --filter @goodform/server --filter @goodform/web dev",
    "build": "pnpm --filter @goodform/shared build && pnpm --filter @goodform/web build && pnpm --filter @goodform/server build",
    "start": "pnpm --filter @goodform/server start",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @goodform/server db:generate",
    "db:migrate": "pnpm --filter @goodform/server db:migrate",
    "db:seed": "pnpm --filter @goodform/server db:seed"
  }
}
