# --- Database ---
DATABASE_URL=postgres://admin:CHANGE_ME@127.0.0.1:5432/goodform

# --- Server ---
PORT=8790
# Base URL the app is served from (used by Better Auth)
APP_URL=http://localhost:8790

# --- Auth ---
# Random 32+ char string: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to enable email/password login for local development
DEV_LOGIN=true
