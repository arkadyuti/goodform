# --- Database ---
DATABASE_URL=postgres://admin:CHANGE_ME@127.0.0.1:5432/goodform

# --- Server ---
PORT=8790
# The URL you actually open in the browser. Better Auth builds its OAuth
# redirects from this, so in development it must be the Vite dev server
# (5173), not the API port — /api is proxied through to 8790 anyway.
# Development: http://localhost:5173
# Production:  your real origin, where one process serves API and app
APP_URL=http://localhost:5173

# --- Auth ---
# Random 32+ char string: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME
# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: {APP_URL}/api/auth/callback/google
# So in development that is http://localhost:5173/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set to "true" to enable email/password login for local development
DEV_LOGIN=true

# Web Push (optional). Generate once:
#   pnpm --filter @goodform/server keys:vapid
# Without these the app falls back to the due-now card on Today and never
# asks for notification permission.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Set to false to stop the in-process reminder scheduler (default: on).
REMINDER_SCHEDULER=true

# Addresses allowed to create an account, comma separated. Empty means anyone
# can sign up — right on a laptop, wrong on a public URL. Gates both the
# email/password form and first Google sign-in. Existing accounts are unaffected.
SIGNUP_ALLOWLIST=
